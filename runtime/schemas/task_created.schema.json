      "type": "string"
    },
    "type": {
      "type": "string"
    },
    "inputs_ref": {
      "type": "string"
    },
    "deps": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "eligibility": {
      "type": "object",
      "properties": {
        "capability_key": {
          "type": "string"
        },
        "role": {
          "type": "string"
        }
      }
    }
  }
}